# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DATABASE_URL=postgresql://truthlens_user:password@localhost:5432/truthlens_db

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# IBM watsonx.ai
WATSONX_API_KEY=your-ibm-watsonx-api-key
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2
WATSONX_MAX_RETRIES=2
WATSONX_TIMEOUT_SEC=30

# IBM Cloud Object Storage (Phase 5)
IBM_COS_API_KEY=your-cos-api-key
IBM_COS_INSTANCE_CRN=your-cos-instance-crn
IBM_COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
IBM_COS_BUCKET=truthlens-uploads

# Redis (for Celery task queue)
REDIS_URL=redis://localhost:6379/0

# Frontend
FRONTEND_URL=http://localhost:4200

# Rate limiting
ANALYSIS_RATE_LIMIT=10/hour
REPORT_RATE_LIMIT=5/hour

# OCR
TESSERACT_CMD=/usr/bin/tesseract

# AI Provider (watsonx | mock)
AI_PROVIDER=mock

# Content analysis blend ratio (AI weight 0.0–1.0; pattern weight = 1 - this)
CONTENT_AI_WEIGHT=0.60

# Security
CORS_ALLOWED_ORIGINS=http://localhost:4200
